# ===========================================
# Security AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Backend
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# AI Service
AI_SERVICE_PORT=5000
AI_SERVICE_HOST=0.0.0.0
AI_DEVICE=auto
AI_CUDA_DEVICE=0
AI_ONNX_PROVIDER=auto

# Database
DATABASE_PATH=./data/security-ai.db

# WhatsApp Business API
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v17.0
WHATSAPP_RECIPIENT_NUMBER=

# MediaMTX
MEDIAMTX_PORT=8554
MEDIAMTX_RTSP_PORT=8555

# Video Buffer
BUFFER_DURATION_SECONDS=30
PRE_EVENT_SECONDS=15
POST_EVENT_SECONDS=15

# AI / Detection
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
INFERENCE_FPS=0
CPU_INFERENCE_FPS=5
GPU_INFERENCE_FPS=10
WARMUP_FRAME_WIDTH=1280
WARMUP_FRAME_HEIGHT=720
FACE_RECOGNITION_THRESHOLD=0.6
MOTION_SENSITIVITY=0.5

# Dangerous object detection
WEAPON_ENABLED=true
WEAPON_MODEL=Subh775/Threat-Detection-YOLOv8n
WEAPON_MODEL_FILENAME=weights/best.pt
WEAPON_MODEL_REVISION=c6d6fa4e6c9bfd4c4fccb46478db23609e5468fb
# Set this to a bundled .pt file for a fully offline demo
WEAPON_MODEL_PATH=
WEAPON_CONFIDENCE_THRESHOLD=0.4
WEAPON_INFERENCE_FPS=0
CPU_WEAPON_INFERENCE_FPS=5
GPU_WEAPON_INFERENCE_FPS=10
WEAPON_IMAGE_SIZE=960
WEAPON_IOU_THRESHOLD=0.5
WEAPON_CLASSES=gun,knife
WEAPON_CONFIRM_HITS=2
WEAPON_CONFIRM_WINDOW=3

# Suspicious behavior heuristics
LOITERING_THRESHOLD_SECONDS=30
SUSPICIOUS_BEHAVIOR_CONFIRM_SECONDS=1.0

# Alerts
ALERT_COOLDOWN_SECONDS=60

# Storage
MAX_STORAGE_GB=50
RETENTION_DAYS=30

# Evidence
EVIDENCE_DIR=./evidence

# Security
JWT_SECRET=change-this-to-a-random-secret
