# Security AI - Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.

# Backend and AI service
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1
AI_SERVICE_PORT=5000
AI_SERVICE_HOST=0.0.0.0
AI_DEVICE=auto
AI_CUDA_DEVICE=0
AI_ONNX_PROVIDER=auto

# Local database
DATABASE_PATH=./data/security-ai.db

# Media and video buffer
MEDIAMTX_PORT=8554
MEDIAMTX_RTSP_PORT=8555
BUFFER_DURATION_SECONDS=30
PRE_EVENT_SECONDS=15
POST_EVENT_SECONDS=15

# Object detection and runtime-selected throughput (0 means automatic)
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
INFERENCE_FPS=0
CPU_INFERENCE_FPS=5
GPU_INFERENCE_FPS=10
WARMUP_FRAME_WIDTH=1280
WARMUP_FRAME_HEIGHT=720
FACE_RECOGNITION_THRESHOLD=0.6
MOTION_SENSITIVITY=0.5
MODEL_DIR=./models

# Weapon pipeline
WEAPON_ENABLED=true
WEAPON_MODEL=Hadi959/weapon-detection-yolov8
WEAPON_MODEL_PATH=./models/weapon-best.pt
WEAPON_MODEL_FILENAME=best.pt
WEAPON_MODEL_REVISION=
WEAPON_VERIFIER_MODEL=Subh775/Threat-Detection-YOLOv8n
WEAPON_VERIFIER_MODEL_PATH=./models/weapon-verifier.pt
WEAPON_VERIFIER_CONFIDENCE=0.15
WEAPON_CONFIDENCE_THRESHOLD=0.30
KNIFE_CONFIDENCE_THRESHOLD=0.50
WEAPON_INFERENCE_FPS=0
CPU_WEAPON_INFERENCE_FPS=5
GPU_WEAPON_INFERENCE_FPS=10
WEAPON_INFERENCE_SIZE=960
WEAPON_IMAGE_SIZE=960
WEAPON_IOU_THRESHOLD=0.5
WEAPON_CLASSES=gun,knife
WEAPON_CONFIRMATIONS=2
WEAPON_CONFIRMATION_WINDOW=8
WEAPON_CONFIRM_HITS=2
WEAPON_CONFIRM_WINDOW=8

# Face-cover and incident lifecycle pipeline
FACE_COVER_CONFIDENCE_THRESHOLD=0.50
FACE_COVER_ENABLED=true
FACE_COVER_CONFIRMATIONS=5
FACE_COVER_CONFIRMATION_WINDOW=8
THREAT_CLEAR_OBSERVATIONS=50
THREAT_MIN_REARM_SECONDS=60

# Suspicious behavior heuristics and legacy alert cooldown
LOITERING_THRESHOLD_SECONDS=30
SUSPICIOUS_BEHAVIOR_CONFIRM_SECONDS=1.0
ALERT_COOLDOWN_SECONDS=60

# Storage and evidence
MAX_STORAGE_GB=50
RETENTION_DAYS=30
EVIDENCE_DIR=./evidence

# Security
JWT_SECRET=change-this-to-a-random-secret
