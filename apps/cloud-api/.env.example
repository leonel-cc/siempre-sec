NODE_ENV=development
PORT=3100
CLOUD_WEB_ORIGIN=http://localhost:4173,http://localhost:5174
DATABASE_URL=postgresql://security_ai:security_ai_dev@localhost:5432/security_ai_cloud
# Local development only. Remove this and configure OIDC for deployed environments.
DEV_AUTH_ENABLED=true
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=siempre-cloud-api
OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WHATSAPP_ENABLED=false
PHONE_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_AUTH_TEMPLATE_NAME=siempre_verification_code
WHATSAPP_ALERT_TEMPLATE_NAME=siempre_security_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Development demo only. Set to hello_world when approved OTP/alert templates are unavailable.
WHATSAPP_DEMO_TEMPLATE_NAME=
