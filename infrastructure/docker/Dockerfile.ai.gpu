FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    curl \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/ai/requirements.txt apps/ai/requirements-gpu.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip install --no-cache-dir --upgrade torch==2.3.1 torchvision==0.18.1 \
       --index-url https://download.pytorch.org/whl/cu121 \
    && python3 -m pip uninstall -y onnxruntime onnxruntime-gpu \
    && python3 -m pip install --no-cache-dir --force-reinstall --no-deps \
       onnxruntime-gpu==1.18.0 \
       --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/

COPY apps/ai ./

RUN mkdir -p /app/evidence /app/models/weights /app/models/embeddings

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import json,urllib.request; d=json.load(urllib.request.urlopen('http://localhost:5000/health')); assert d['status']=='ok' and d['runtime']['device'].startswith('cuda')"

CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
